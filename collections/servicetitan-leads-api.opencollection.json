            "url": "https://api.servicetitan.io/accounting/v2/{tenant}/leads/:id/dismiss",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Dismiss Lead"
        }
